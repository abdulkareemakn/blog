---
import type { MarkdownHeading } from "astro";
interface Props { headings: MarkdownHeading[] }
const headings = Astro.props.headings.filter(({ depth }) => depth >= 2 && depth <= 4);
---
{headings.length > 0 && (
  <nav class="article-toc" aria-label="Table of contents" data-pagefind-ignore>
    <div class="article-toc__inner">
      <h2 class="eyebrow mb-4">On this page</h2>
      <ul class="grid gap-2 text-sm">
        {headings.map((heading) => (
          <li style={`padding-left: ${(heading.depth - 2) * 0.75}rem`}>
            <a class="link-quiet" href={`#${heading.slug}`}>{heading.text}</a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
)}
<style>
  .article-toc { display: none; }
  @media (min-width: 1280px) {
    .article-toc { display: block; position: absolute; left: 100%; top: 0; width: 14rem; height: 100%; padding-left: 2rem; }
    .article-toc__inner { position: sticky; top: 5rem; max-height: calc(100dvh - 6rem); overflow-y: auto; border-left: 1px solid var(--border); padding-left: 1rem; }
  }
</style>
