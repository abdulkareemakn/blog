---
import { getEntry, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
const about = await getEntry("pages", "about");
if (!about) throw new Error("Missing about page content");
const { Content } = await render(about);
---
<BaseLayout title={about.data.title} description={about.data.description} image={about.data.ogImage} canonicalURL={about.data.canonicalURL}>
  <SiteHeader />
  <main id="content" class="outer">
    <div class="canvas">
      <header class="pagehead"><h1 class="pagehead-title">{about.data.title}</h1></header>
      <div class="prose"><Content /></div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
