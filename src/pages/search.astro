---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
---
<BaseLayout title="Search" description="Search the full text of every published post." noindex>
  <SiteHeader />
  <main id="content" class="outer">
    <div class="canvas">
      <header class="pagehead">
        <h1 class="pagehead-title">Search posts</h1>
        <form class="mt-8 flex gap-2" role="search" action="/search/">
          <label class="sr-only" for="search-input">Search posts</label>
          <input id="search-input" class="field" name="q" type="search" placeholder="Titles, commands, and article text…" />
          <button class="btn btn-solid" type="submit">Search</button>
        </form>
        <p class="mt-4 text-sm text-muted-foreground" data-summary aria-live="polite"></p>
        <noscript>Search requires JavaScript. <a href="/posts/">Browse all posts</a>.</noscript>
      </header>
      <div class="grid gap-7" data-results></div>
    </div>
  </main>
  <SiteFooter />
  <style>
    [data-results] :global(.search-result-title) {
      font-size: 1.5rem;
      white-space: normal;
    }
    [data-results] :global(.search-result-meta) {
      margin-top: 0.75rem;
      font-size: 1rem;
      letter-spacing: normal;
      text-transform: none;
    }
  </style>
  <script is:inline type="module">
    import { searchPosts, resultLink } from "/search.js";
    const input = document.getElementById("search-input");
    const summary = document.querySelector("[data-summary]");
    const results = document.querySelector("[data-results]");
    let request = 0;
    async function render() {
      const currentRequest = ++request;
      const query = input.value.trim();
      results.replaceChildren();
      summary.textContent = query ? "Searching…" : "";
      if (!query) return;
      try {
        const found = await searchPosts(query);
        if (currentRequest !== request) return;
        summary.textContent = `${found.total} ${found.total === 1 ? "result" : "results"} for “${query}”.`;
        results.replaceChildren(...found.items.map(resultLink));
      } catch {
        if (currentRequest === request) summary.textContent = "Search is unavailable. Please try again or browse the archive.";
      }
    }
    input.value = new URLSearchParams(location.search).get("q") || "";
    input.addEventListener("input", render);
    render();
  </script>
</BaseLayout>
