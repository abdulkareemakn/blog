---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { getTagList, tagHref } from "@/lib/posts";
const tags = getTagList(await getCollection("posts"));
---
<BaseLayout title="Tags" description="Browse posts by topic.">
  <SiteHeader />
  <main id="content" class="outer">
    <div class="canvas">
      <header class="pagehead"><h1 class="pagehead-title">Tags</h1></header>
      <ul class="grid gap-7">
        {tags.map((tag) => <li class="border-b border-border pb-7"><a href={tagHref(tag.name)} class="link-title flex justify-between gap-4"><span class="link-title__text text-xl font-semibold">{tag.name}</span><span class="pill">{tag.count} posts</span></a></li>)}
      </ul>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
